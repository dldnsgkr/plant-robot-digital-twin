<?xml version="1.0" ?>
<!--
  발전소 Virtual Plant 월드 (Gazebo Harmonic / gz-sim8)

  좌표계 (z-up, 단위 m):
  - 공장:  x[-12.5, 12.5] × y[-9, 9],   높이 7  (25 × 18 요구조건 충족)
  - 복도:  x[12.5, 57.5]  × y[-1.75, 1.75], 높이 4 (45 × 3.5 요구조건 충족)
  - 공장 동쪽 벽(x=12.5)의 y[-1.75,1.75] 구간이 복도로 통하는 개구부

  요구 최소수량: 복도 장애물 3, 공장 장애물 5, 공장기계 1 (+ 계단, 가스탱크,
  충전 스테이션, 게이지 패널은 이후 모듈에서 사용)
-->
<sdf version="1.8">
  <world name="plant">
    <physics name="default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- 외란 인가용 (Fall Recovery / MPC 강건성 테스트): /world/plant/wrench 토픽 -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.35 0.4 0.45 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <!-- 공장 내부 조명 -->
    <light type="point" name="factory_light_1">
      <pose>-6 0 6.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.7 1</diffuse>
      <attenuation><range>25</range><linear>0.05</linear></attenuation>
    </light>
    <light type="point" name="factory_light_2">
      <pose>6 0 6.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.7 1</diffuse>
      <attenuation><range>25</range><linear>0.05</linear></attenuation>
    </light>
    <!-- 복도 조명 (Module 2 저조도 실험 시 이 조명을 끄거나 어둡게 조정) -->
    <light type="point" name="corridor_light_1">
      <pose>25 0 3.8 0 0 0</pose>
      <diffuse>0.6 0.6 0.55 1</diffuse>
      <attenuation><range>18</range><linear>0.08</linear></attenuation>
    </light>
    <light type="point" name="corridor_light_2">
      <pose>45 0 3.8 0 0 0</pose>
      <diffuse>0.6 0.6 0.55 1</diffuse>
      <attenuation><range>18</range><linear>0.08</linear></attenuation>
    </light>

    <!-- ============ 바닥 ============ -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>140 60</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>140 60</size></plane></geometry>
          <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.45 0.45 0.47 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ 건물 (벽체) ============ -->
    <model name="plant_building">
      <static>true</static>
      <link name="walls">
        <!-- 공장 북벽 y=+9 -->
        <collision name="f_north_c"><pose>0 9 3.5 0 0 0</pose><geometry><box><size>25 0.2 7</size></box></geometry></collision>
        <visual name="f_north_v"><pose>0 9 3.5 0 0 0</pose><geometry><box><size>25 0.2 7</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
        <!-- 공장 남벽 y=-9 -->
        <collision name="f_south_c"><pose>0 -9 3.5 0 0 0</pose><geometry><box><size>25 0.2 7</size></box></geometry></collision>
        <visual name="f_south_v"><pose>0 -9 3.5 0 0 0</pose><geometry><box><size>25 0.2 7</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
        <!-- 공장 서벽 x=-12.5 -->
        <collision name="f_west_c"><pose>-12.5 0 3.5 0 0 0</pose><geometry><box><size>0.2 18.2 7</size></box></geometry></collision>
        <visual name="f_west_v"><pose>-12.5 0 3.5 0 0 0</pose><geometry><box><size>0.2 18.2 7</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
        <!-- 공장 동벽 x=12.5 (복도 개구부 y[-1.75,1.75] 제외한 두 구간) -->
        <collision name="f_east_n_c"><pose>12.5 5.375 3.5 0 0 0</pose><geometry><box><size>0.2 7.25 7</size></box></geometry></collision>
        <visual name="f_east_n_v"><pose>12.5 5.375 3.5 0 0 0</pose><geometry><box><size>0.2 7.25 7</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
        <collision name="f_east_s_c"><pose>12.5 -5.375 3.5 0 0 0</pose><geometry><box><size>0.2 7.25 7</size></box></geometry></collision>
        <visual name="f_east_s_v"><pose>12.5 -5.375 3.5 0 0 0</pose><geometry><box><size>0.2 7.25 7</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
        <!-- 개구부 상단 인방 (복도 높이 4 위쪽, z 4~7) -->
        <collision name="f_east_lintel_c"><pose>12.5 0 5.5 0 0 0</pose><geometry><box><size>0.2 3.5 3</size></box></geometry></collision>
        <visual name="f_east_lintel_v"><pose>12.5 0 5.5 0 0 0</pose><geometry><box><size>0.2 3.5 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material></visual>
        <!-- 복도 북벽 y=+1.75, x[12.5,57.5] -->
        <collision name="c_north_c"><pose>35 1.75 2 0 0 0</pose><geometry><box><size>45 0.2 4</size></box></geometry></collision>
        <visual name="c_north_v"><pose>35 1.75 2 0 0 0</pose><geometry><box><size>45 0.2 4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.65 0.63 0.58 1</diffuse></material></visual>
        <!-- 복도 남벽 y=-1.75 -->
        <collision name="c_south_c"><pose>35 -1.75 2 0 0 0</pose><geometry><box><size>45 0.2 4</size></box></geometry></collision>
        <visual name="c_south_v"><pose>35 -1.75 2 0 0 0</pose><geometry><box><size>45 0.2 4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.65 0.63 0.58 1</diffuse></material></visual>
        <!-- 복도 끝벽 x=57.5 -->
        <collision name="c_end_c"><pose>57.5 0 2 0 0 0</pose><geometry><box><size>0.2 3.7 4</size></box></geometry></collision>
        <visual name="c_end_v"><pose>57.5 0 2 0 0 0</pose><geometry><box><size>0.2 3.7 4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.65 0.63 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 복도 험지 장애물 3개 (지진으로 널린 파이프) ============
         pipe_1: 낮은 파이프(0.07m) 전폭 차단 — 지형 적응 보행으로 '넘는' 대상
         pipe_2/3: 굵은 파이프 부분 차단(주행 차선 y±0.35는 비움) — '우회' 대상 -->
    <model name="corridor_pipe_1">
      <static>true</static>
      <pose>20 0 0.035 1.5708 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>3.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>3.4</length></cylinder></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_pipe_2">
      <static>true</static>
      <pose>32 1.05 0.08 1.5708 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_pipe_3">
      <static>true</static>
      <pose>45 -1.05 0.12 1.5708 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.12</radius><length>1.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 공장 험지 장애물 5개 ============ -->
    <model name="factory_pallet_1">
      <static>true</static>
      <pose>-6 4 0.075 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.8 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 0.15</size></box></geometry>
          <material><ambient>0.55 0.42 0.25 1</ambient><diffuse>0.55 0.42 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="factory_pallet_2">
      <static>true</static>
      <pose>3 -5 0.075 0 0 -0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.8 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 0.15</size></box></geometry>
          <material><ambient>0.55 0.42 0.25 1</ambient><diffuse>0.55 0.42 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="factory_crate">
      <static>true</static>
      <pose>5 5 0.3 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="factory_fallen_pipe">
      <static>true</static>
      <pose>-3 -3 0.1 0 1.5708 0.8</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.10</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.10</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="factory_barrel">
      <static>true</static>
      <pose>8 2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.6 1</ambient><diffuse>0.2 0.35 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 공장기계 1식 (본체 + 모터 + 배관) ============ -->
    <model name="factory_machine">
      <static>true</static>
      <pose>-9 -6 0 0 0 0</pose>
      <link name="link">
        <collision name="body_c"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>3 2 2.5</size></box></geometry></collision>
        <visual name="body_v"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>3 2 2.5</size></box></geometry>
          <material><ambient>0.25 0.45 0.35 1</ambient><diffuse>0.25 0.45 0.35 1</diffuse></material></visual>
        <collision name="motor_c"><pose>1.9 0 0.6 0 1.5708 0</pose><geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="motor_v"><pose>1.9 0 0.6 0 1.5708 0</pose><geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
        <!-- 상부 배관: Module 2 열화상 점검 대상 (이음매 과열 시나리오) -->
        <collision name="pipe_c"><pose>0 0 3.0 0 1.5708 0</pose><geometry><cylinder><radius>0.15</radius><length>6.5</length></cylinder></geometry></collision>
        <visual name="pipe_v"><pose>0 0 3.0 0 1.5708 0</pose><geometry><cylinder><radius>0.15</radius><length>6.5</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 가스 탱크 (Module 3 누출원 시나리오 지점) ============ -->
    <model name="gas_tank">
      <static>true</static>
      <pose>-9 6 2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>1.2</radius><length>4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>1.2</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.75 0.72 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 계단 (Module 1 험지: 4단, 단높이 0.18 / 단깊이 0.35) ============ -->
    <model name="stairs">
      <static>true</static>
      <pose>9.5 -7 0 0 0 0</pose>
      <link name="link">
        <collision name="s1_c"><pose>0 0 0.09 0 0 0</pose><geometry><box><size>0.35 2 0.18</size></box></geometry></collision>
        <visual name="s1_v"><pose>0 0 0.09 0 0 0</pose><geometry><box><size>0.35 2 0.18</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material></visual>
        <collision name="s2_c"><pose>0.35 0 0.18 0 0 0</pose><geometry><box><size>0.35 2 0.36</size></box></geometry></collision>
        <visual name="s2_v"><pose>0.35 0 0.18 0 0 0</pose><geometry><box><size>0.35 2 0.36</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material></visual>
        <collision name="s3_c"><pose>0.7 0 0.27 0 0 0</pose><geometry><box><size>0.35 2 0.54</size></box></geometry></collision>
        <visual name="s3_v"><pose>0.7 0 0.27 0 0 0</pose><geometry><box><size>0.35 2 0.54</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material></visual>
        <collision name="s4_c"><pose>1.05 0 0.36 0 0 0</pose><geometry><box><size>0.35 2 0.72</size></box></geometry></collision>
        <visual name="s4_v"><pose>1.05 0 0.36 0 0 0</pose><geometry><box><size>0.35 2 0.72</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material></visual>
        <!-- 상부 플랫폼 -->
        <collision name="p_c"><pose>2.225 0 0.36 0 0 0</pose><geometry><box><size>2 2 0.72</size></box></geometry></collision>
        <visual name="p_v"><pose>2.225 0 0.36 0 0 0</pose><geometry><box><size>2 2 0.72</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 아날로그 게이지 패널 (Module 2 판독 대상, 복도 벽면) ============ -->
    <model name="gauge_panel">
      <static>true</static>
      <pose>38 1.62 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.06 0.5</size></box></geometry></collision>
        <visual name="panel_v"><geometry><box><size>0.5 0.06 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material></visual>
        <!-- 눈금판: 0~10 bar, 270° 스윕 (텍스처는 models/gauge/make_dial.py 생성) -->
        <visual name="dial_v"><pose>0 -0.034 0 0 0 0</pose>
          <geometry><box><size>0.36 0.005 0.36</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://gauge/dial.png</albedo_map></metal></pbr>
          </material></visual>
      </link>
    </model>

    <!-- 게이지 바늘: plant_process 노드가 압력값에 따라 pose(y축 회전)를 갱신 -->
    <model name="gauge_needle">
      <static>true</static>
      <pose>38 1.575 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><pose>0.055 0 0 0 0 0</pose>
          <geometry><box><size>0.13 0.004 0.014</size></box></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.8 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============ 충전 스테이션 (Module 3 Return-to-Home 목표점) ============ -->
    <model name="charging_station">
      <static>true</static>
      <pose>11 7.5 0.025 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 0.05</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
